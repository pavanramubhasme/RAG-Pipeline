# Copy to .env. Every setting in ragapp/config.py can be set here with the RAG_ prefix.
# HF_* lines are read by Hugging Face only when uv loads this file: set UV_ENV_FILE=.env

# Model downloads: free token from huggingface.co/settings/tokens (avoids 403 errors)
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Keep the downloaded models in the project (Windows cleans the Temp folder)
RAG_MODEL_CACHE_DIR=.cache/models

# Vector DB: empty = embedded (local .qdrant folder, one process at a time).
# Recommended once you run API + MCP + CLI together: a Qdrant server
#   docker run -d -p 6333:6333 qdrant/qdrant:v1.20.0
RAG_QDRANT_URL=

# LLM (Ollama). Bigger/better if your machine allows: qwen3:8b | granite4.1:8b
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and can add ~2 s per call
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=granite4:3b
# Temperature 0 + fixed seed: the same question gives the same answer
RAG_LLM_TEMPERATURE=0
RAG_LLM_SEED=42
# RAGAS judge: a stronger model gives more trustworthy scores (defaults to RAG_LLM_MODEL)
RAG_JUDGE_MODEL=

# Agent behaviour
RAG_MAX_REWRITES=1
RAG_GROUNDING_CHECK=true
# Earlier chat messages used to understand follow-up questions (0 = single-turn)
RAG_MAX_HISTORY_TURNS=6

# Answer cache: the same question again is answered instantly (no retrieval, no LLM call).
# Cleared automatically when documents are ingested; restart the API to clear it by hand.
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_S=3600

# Access control: each request runs as the user of its API key (config/identities.json);
# retrieval only sees chunks whose classification label that user's role may see.
RAG_ACCESS_CONTROL=true
RAG_IDENTITIES_FILE=config/identities.json
# Requests without a key run as this role (deny by default); empty = reject them
RAG_ANONYMOUS_ROLE=visitor
# Label for pages/files that state none ("deny by default": not public)
RAG_DEFAULT_CLASSIFICATION=INTERNAL

# Guardrails (rules are always on; the guard model is optional and costs one LLM call per risk)
RAG_GUARDRAILS_ENABLED=true
# Open guard model via Ollama, e.g. granite3-guardian:2b (run: ollama pull granite3-guardian:2b). Empty = off
RAG_GUARD_MODEL=
RAG_GUARD_RISKS=["jailbreak","harm"]
# Secrets and personal data masked in questions (before LLM, logs, traces) and in answers
RAG_REDACT_INPUT_PII=["secret","email","phone","iban","card"]
RAG_REDACT_OUTPUT_PII=["secret","iban","card"]
# At ingestion: secrets masked in every chunk, contact data in CONFIDENTIAL/RESTRICTED chunks
RAG_MASK_SECRETS=true
RAG_CONFIDENTIAL_PII_KINDS=["email","phone"]

# Retrieval tuning (run `python -m eval.run_eval --ablation` before changing)
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.05

# Tracing: start Phoenix (docker run -p 6006:6006 arizephoenix/phoenix) then set true
RAG_TRACING_ENABLED=false
RAG_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# The key the UI (default user) and the MCP server send. With access control on, use a demo
# key from config/identities.json, e.g. employee-demo-key. With it off, the API requires this key.
RAG_API_KEY=employee-demo-key
# Where the UI and the MCP server find the API
RAG_API_URL=http://127.0.0.1:8000
